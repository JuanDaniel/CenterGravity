<?xml version="1.0" encoding="utf-8"?>
<!--
  Autodesk ApplicationPlugins bundle descriptor.
  Deploy the whole CenterGravity.bundle folder to either

    %ProgramData%\Autodesk\ApplicationPlugins\   (all users)
    %AppData%\Autodesk\ApplicationPlugins\       (current user)

  Revit picks the matching <Components> block per release automatically.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="Revit"
    ProductType="Application"
    Name="Center Gravity"
    Description="Center of gravity of an element or a set of elements - essential data for lifting studies."
    AppVersion="1.1.0"
    FriendlyVersion="1.1.0"
    ProductCode="{48BD08DC-F6B7-400B-85CE-70071034E058}"
    Author="Juan Daniel SANTANA"
    Icon="./Contents/Resources/icon.ico"
    HelpFile="https://github.com/JuanDaniel/CenterGravity/wiki/Home">

  <CompanyDetails Name="JDS - Juan Daniel SANTANA"
                  Url="https://github.com/JuanDaniel/CenterGravity" />

  <Components Description="Autodesk Revit 2024">
    <RuntimeRequirements OS="Win64" Platform="Revit" SeriesMin="R2024" SeriesMax="R2024" />
    <ComponentEntry AppName="CenterGravity" Version="1.1.0" ModuleName="./Contents/2024/CenterGravity.addin" />
  </Components>

  <Components Description="Autodesk Revit 2025">
    <RuntimeRequirements OS="Win64" Platform="Revit" SeriesMin="R2025" SeriesMax="R2025" />
    <ComponentEntry AppName="CenterGravity" Version="1.1.0" ModuleName="./Contents/2025/CenterGravity.addin" />
  </Components>

  <Components Description="Autodesk Revit 2026">
    <RuntimeRequirements OS="Win64" Platform="Revit" SeriesMin="R2026" SeriesMax="R2026" />
    <ComponentEntry AppName="CenterGravity" Version="1.1.0" ModuleName="./Contents/2026/CenterGravity.addin" />
  </Components>

  <Components Description="Autodesk Revit 2027">
    <RuntimeRequirements OS="Win64" Platform="Revit" SeriesMin="R2027" SeriesMax="R2027" />
    <ComponentEntry AppName="CenterGravity" Version="1.1.0" ModuleName="./Contents/2027/CenterGravity.addin" />
  </Components>

</ApplicationPackage>
