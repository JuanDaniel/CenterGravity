<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Build the add-in only against nuget.org, ignoring any broken/private
       feed configured globally on the build machine. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
