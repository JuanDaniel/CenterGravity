<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CenterGravity - Revit add-in, multi-version (2024 -> 2027).

    One version from the command line (CI):
      dotnet build CenterGravity/CenterGravity.csproj -c Release -p:RevitVersion=2026

    Visual Studio: pick a configuration  Debug_2024 ... Release_2027
    Full package (every version + .bundle + zip):  pwsh ./build.ps1

    RevitVersion -> target framework / obj / bin mapping lives in
    Directory.Build.props. RevitVersion also drives the Revit API package
    versions below (2024 = .NET Framework 4.8, 2025+ = .NET 8).
  -->

  <PropertyGroup>
    <Configurations>Debug;Release;Debug_2024;Debug_2025;Debug_2026;Debug_2027;Release_2024;Release_2025;Release_2026;Release_2027</Configurations>

    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Company>JDS - Juan Daniel SANTANA</Company>
    <Product>Center Gravity</Product>
    <Description>Center of gravity for Revit model elements.</Description>

    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(Configuration.StartsWith('Release'))">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="$(RevitVersion).*" />
  </ItemGroup>

  <!-- BCL reference assemblies so the .NET Framework 4.8 target (Revit 2024)
       builds on machines without the full targeting pack. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
