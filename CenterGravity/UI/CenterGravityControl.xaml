<UserControl x:Class="BBI.JD.UI.CenterGravityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="320" d:DesignHeight="520"
             MinWidth="260">

    <UserControl.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="IsReadOnlyCaretVisible" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3,2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding Summary}"
                   TextWrapping="Wrap"
                   Opacity="0.9"
                   Margin="0,0,0,6" />

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Extended"
                  RowHeaderWidth="0">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Skipped}" Value="True">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="ToolTip" Value="No solid geometry - left out of the calculation" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="Auto" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2">
            <TextBlock Text="Coordinates measured from" Style="{StaticResource Caption}" />
            <ComboBox ItemsSource="{Binding ReferenceOptions}"
                      SelectedItem="{Binding SelectedReference, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Volume" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Volume, Mode=OneWay}" Style="{StaticResource ValueBox}" Margin="0,2" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding X, Mode=OneWay}" Style="{StaticResource ValueBox}" Margin="0,2" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Y" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding Y, Mode=OneWay}" Style="{StaticResource ValueBox}" Margin="0,2" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Z" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Z, Mode=OneWay}" Style="{StaticResource ValueBox}" Margin="0,2" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="(X; Y; Z)" VerticalAlignment="Center" Margin="0,2,8,2" />
            <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding Xyz, Mode=OneWay}" Style="{StaticResource ValueBox}" Margin="0,2" />
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Place marker" Command="{Binding PlaceCommand}" Padding="12,4" Margin="0,0,6,0" />
            <Button Content="Copy" Command="{Binding CopyCommand}" Padding="12,4" Margin="0,0,6,0" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Padding="12,4" Margin="0,0,6,0" />
            <Button Content="Clear" Command="{Binding ClearCommand}" Padding="12,4" />
        </StackPanel>
    </Grid>
</UserControl>
